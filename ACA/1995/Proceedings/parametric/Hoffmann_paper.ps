/truepoint {dcmscale div} def
/inch {72 mul truepoint} def
/cm {2.54 div inch} def

/papersize {21.0 cm 29.7 cm} def  % A4
/paperoffset {0 inch 0 inch} def

/title () def
/titlefontsize {18 truepoint} def
/titlefont
 {dcmfontname findfont
  titlefontsize scalefont setfont} def

/dcmsize {6 inch 6 inch} def
/dcmoffset {0 inch 0 inch} def
/dcmscale 1.5 def
/dcmfontname /Times-Roman def
/dcmfontsize {12 truepoint} def
/dcmfontheight {dcmfontsize 0.7 mul} def
/dcmfontborder {1 truepoint} def
/dcmfont
 {dcmfontname findfont
  dcmfontsize scalefont setfont} def

/white {setblack boldline continuousline} def
/red {setblack boldline continuousline} def
/yellow {setblack boldline continuousline}  def
/blue {setblack boldline continuousline} def
/grey {setblack boldline continuousline} def
/orange {setblack boldline continuousline} def
/pink {setblack boldline continuousline} def
/black {setwhite boldline continuousline} def
/magenta {setblack lightline continuousline} def
/green {setblack lightline continuousline} def
/cyan {setblack mediumline continuousline} def
/bordercolor {setblack mediumline continuousline} def
/titlecolor {setblack} def
/unknowncolor {white} def

/boldline {1 truepoint setlinewidth} def
/mediumline {0.5 truepoint setlinewidth} def
/lightline {0 truepoint setlinewidth} def
/dottedline {[2 truepoint 10 truepoint] 0 setdash} def
/continuousline {[] 0 setdash} def
/setblack {0 setgray ink} def
/setwhite {1 setgray ink} def
/setclear {noink} def

/ink
 {/dcmstroke {stroke} def
  /dcmfill {fill} def
  /dcmshow {show} def} def

/noink
 {/dcmstroke {newpath} def
  /dcmfill {newpath} def
  /dcmshow {pop} def} def

/center  % stk: (string)
 {dup stringwidth
  pop 2 div neg dcmfontheight 2 div neg
  rmoveto} def

/box  % stk: xsize ysize
 {currentpoint newpath moveto
  dup 0 exch rlineto % stk: x y
  exch 0 rlineto     % stk: y
  0 exch neg rlineto % stk:
  closepath} def

/textbox  % stk: (string)
 {dup stringwidth pop dcmfontheight
  dcmfontborder dup neg dup rmoveto
 2 mul dup 4 -1 roll add 3 1 roll add box} def

/dcmline  % stk: xs ys xe ye
 {4 2 roll
  newpath moveto lineto dcmstroke} def

/dcmarc  % stk: x y r ang1 ang2
 {newpath arcn dcmstroke} def

/dcmtext % stk: x y (string)
 {3 1 roll moveto center
  gsave textbox 1 setgray dcmfill
  grestore dcmshow} def

dcmscale dup scale
papersize 2 div exch 2 div exch translate  % center page
paperoffset translate
setblack

save
0 0 moveto dcmsize 2 div neg exch pop 0 exch rmoveto
titlefont 0 titlefontsize 2 mul neg rmoveto
title center titlecolor dcmshow
0 0 moveto dcmsize 2 div neg exch 2 div neg exch rmoveto
dcmsize box gsave clip newpath

dcmoffset translate
dcmfont

