/* EasyChair style sheets for EasyChair ads */

/* style 1 among alteranting styles */
.adhead1 {
    background-color:black;
    text-align:center;
    width:280px;
    color:white;
    font-size:12px;
    font-weight:bold;
    padding:3px;
    cursor:pointer;
}
.adhead1 a:link {
    color:white;
}
.adhead1 a:visited {
    color:white;
}

.ad1 {
    border:solid 1px #cccccc;
    padding:7px 10px 10px 10px;
    font-size:12px;
    width:264px
}
.ad1 a:link {
    color:#b97e2b;
}
.ad1 a:visited {
    color:#b97e2b;
}

.adcontent1 {
    color:black;
    padding-top:3px;
}

